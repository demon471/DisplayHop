    "前往系统设置" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Open System Settings" } }
      }
    },
    "需要辅助功能权限才能读取和移动其他应用的窗口。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Accessibility permission is required to read and move windows of other apps." } }
