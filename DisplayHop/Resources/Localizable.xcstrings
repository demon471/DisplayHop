    },
    "窗口跨屏移动" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Move Window Across Displays" } }
      }
    },
    "移动的是当前聚焦的窗口，并保持其在屏幕中的相对位置。全屏窗口会先退出全屏再移动。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Moves the focused window and keeps its relative position on screen. Fullscreen windows exit fullscreen before moving." } }
      }
    },
    "图标已隐藏。重新打开屏跃时会自动弹出本设置窗口，可在这里恢复显示。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Icon hidden. Reopen DisplayHop to bring up this settings window and re-enable it here." } }
      }
    },
    "登录时启动屏跃" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Launch DisplayHop at Login" } }
      }
    },
