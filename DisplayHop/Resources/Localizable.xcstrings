{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "菜单栏图标已隐藏" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Menu Bar Icon Hidden" } }
      }
    },
    "屏跃仍在后台运行，全局快捷键可正常使用。\n你可以重新显示菜单栏图标，或退出 App。" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "DisplayHop is still running in the background and global shortcuts keep working.\nYou can show the menu bar icon again, or quit the app." } }
      }
    },
    "显示菜单栏图标" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Show Menu Bar Icon" } }
      }
    },
    "退出" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit" } }
      }
    },
    "移动到下一屏" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to Next Display" } }
      }
    },
    "移动到上一屏" : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Move to Previous Display" } }
      }
    },
